{
  "manifest_version": 3,
  "version": "1.0.0",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "LinkLens"
  },
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "{d27dc7ef-2d70-458f-bdf7-63210db9c5b0}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "LinkLens",
  "description": "Adds a sidebar panel to the browser with a simple page.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "LinkLens"
  },
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "LinkLens"
  },
  "chromium:side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "Side Panel Content"
  },
  "firefox:sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "Side Panel Content",
    "browser_style": false
  },
  "chromium:permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "firefox:permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": [
      "background.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/scripts.ts"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "locked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "firefox:web_accessible_resources": [
    "locked.html"
  ]
}